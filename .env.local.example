# Trading 212 Public API (Basic auth: key as username, secret as password)
# Generate in the T212 app: Settings → API (or Help Centre "How to get your API key")
#
# A key is scoped to ONE account — whichever was selected when you generated it.
# To pull the ISA and the Invest account, name both and give each its own pair.
# The dashboard pools them into a single portfolio; the names only record which
# account each row came from, so keep them stable once you have synced.
T212_ACCOUNTS=isa,invest

T212_ISA_API_KEY=
T212_ISA_API_SECRET=

T212_INVEST_API_KEY=
T212_INVEST_API_SECRET=

# Single account? Drop T212_ACCOUNTS and use the bare pair instead:
# T212_API_KEY=
# T212_API_SECRET=

# Optional: live (default) or demo
# T212_BASE_URL=https://live.trading212.com
# T212_BASE_URL=https://demo.trading212.com
